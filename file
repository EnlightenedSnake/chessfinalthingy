  .black-knight {
  	src = "blackknightImg";
  }
  .black-bishop {
  	src = "blackbishopImg";
  }
  .black-rook {
  	src = "blackrookImg";
  }
  .black-queen {
  	src = "blackqueenImg";
  }
  .black-king {
  	src = "blackkingImg";
  }
  .white-pawn {
  	src = "whitepawnImg";
  }
  .white-knight {
  	src = "whiteknightImg";
  }
  .white-bishop {
  	src = "whitebishopImg";
  }
  .white-rook {
  	src = "whiterookImg";
  }
  .white-queen {
  	src = "whitequeenImg";
  }
  .white-king {
  	src = "whitekingImg";
  }
  .nopiece {
  	<!-- useless class that is a filler so that it can be replaced with an actual piece -->
  }
  .chesspieces-grid {
  	position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    background-color:pink;
    width: min(59.5vw,59.5vh);
    height: min(17.5vw,17.5vh);  
    gap: min(3.5vw,3.5vh);
  }
  .chessboard-number {
  	position: absolute;
    width: 30%;
    height: 30%;
    font-size: min(1.75vh,1.75vw);
    top: 5%;
    left: -2.5%;
